{{ 'component-hero-section.css' | asset_url | stylesheet_tag }}
<section>
    <div class="hero-section">
        <div class="header-column">
            <div class="header-content">
                <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
                <p class="hero-subtitle">{{ section.settings.hero_subtitle }}</p>
                <div>
                    <button class="button">
                        {{ section.settings.button_text }}
                    </button>
                    <button class="button-negative">
                        {{ section.settings.button_text }}
                    </button>
                </div>
            </div>
        </div>
        <div class="header-column">
            <div class="header-image-wrapper">
            <img src="{{ section.settings.hero_image | image_url: width: 1500 }}" alt="Hero Image" class="hero-image" />
            </div>
        </div>
    </div>
</section>

<script>
  // Replace with your own Unsplash API Access Key
  const UNSPLASH_ACCESS_KEY = "J6gErG68mZTISFh5RMMNo9pituuMiCeVgxd35Zy8vdY";

  // Function to load a random image
  function loadRandomImage() {
    $.ajax({
      url: "https://api.unsplash.com/photos/random",
      method: "GET",
      headers: {
        Authorization: "Client-ID " + UNSPLASH_ACCESS_KEY
      },
      success: function (data) {
        // Get the image URL (you can use full, regular, small, etc.)
        const imageUrl = data.urls.regular;

        // Replace the <img> inside .header-image-wrapper
        $(".header-image-wrapper img").attr("src", imageUrl);
      },
      error: function (err) {
        console.error("Error fetching image:", err);
      }
    });
  }

  // Load image on page load
  $(document).ready(function () {
    loadRandomImage();

    // Optional: Refresh image on button click
    $("#refresh-image").click(function () {
      loadRandomImage();
    });
  });
</script>



{%  schema  %} 
{
    "name": "Hero Section",
    "settings": [
        {
            "type": "text",
            "id": "hero_title",
            "label": "Hero Title",
            "default": "Welcome to Our Store"
        },
        {
            "type": "textarea",
            "id": "hero_subtitle",
            "label": "Hero Subtitle",
            "default": "Discover amazing products at unbeatable prices!"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Shop Now"
        },
        {
            "type": "text",
            "id": "button_text_2",
            "label": "Button Text",
            "default": "Shop Now"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero Image"
        }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "Hero Section",
            "category": "Sections"
        }
    ]
}
{% endschema %}