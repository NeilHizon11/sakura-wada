{{ 'component-hero-section.css' | asset_url | stylesheet_tag }}
<section>
    <div class="hero-section">
        <div class="header-column">
            <div class="header-content">
                <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
                <p class="hero-subtitle">{{ section.settings.hero_subtitle }}</p>
                <div>
                    <button class="button">
                        {{ section.settings.button_text }}
                    </button>
                    <button class="button-negative">
                        {{ section.settings.button_text_2 }}
                    </button>
                    <button id="refresh-image" class="button-refresh">
                        Refresh Image
                    </button>
                </div>
            </div>
        </div>
        <div class="header-column">
            <div class="header-image-wrapper">
            <img src="{{ section.settings.hero_image | image_url: width: 1500 }}" alt="Hero Image" class="hero-image" />
            </div>
        </div>
    </div>
  </section>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  const UNSPLASH_ACCESS_KEY = "J6gErG68mZTISFh5RMMNo9pituuMiCeVgxd35Zy8vdY";

  // Hide the image initially
  $(document).ready(function () {
    $(".header-image-wrapper img").css({ opacity: 0, visibility: "hidden" });
  });

  function loadRandomImage() {
    $.ajax({
      url: "https://api.unsplash.com/photos/random",
      method: "GET",
      headers: {
        Authorization: "Client-ID " + UNSPLASH_ACCESS_KEY
      },
      success: function (data) {
        const imageUrl = data.urls && data.urls.regular ? data.urls.regular : "";
        if (imageUrl) {
          const $img = $(".header-image-wrapper img");
          $img.css({ opacity: 0, visibility: "hidden" });
          $img.attr("src", imageUrl);
          // Wait for the image to load before fading in
          $img.on("load", function () {
            $img.off("load"); // Remove handler to avoid multiple triggers
            $img.css({ visibility: "visible" }).animate({ opacity: 1 }, 600);
          });
        }
      },
      error: function (err) {
        console.error("Error fetching image:", err);
      }
    });
  }

  $(document).ready(function () {
    loadRandomImage();

    $("#refresh-image").on("click", function (e) {
      e.preventDefault();
      loadRandomImage();
    });
  });
</script>



{%  schema  %} 
{
    "name": "Hero Section",
    "settings": [
        {
            "type": "text",
            "id": "hero_title",
            "label": "Hero Title",
            "default": "Welcome to Our Store"
        },
        {
            "type": "textarea",
            "id": "hero_subtitle",
            "label": "Hero Subtitle",
            "default": "Discover amazing products at unbeatable prices!"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Shop Now"
        },
        {
            "type": "text",
            "id": "button_text_2",
            "label": "Button Text",
            "default": "Shop Now"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero Image"
        }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "Hero Section",
            "category": "Sections"
        }
    ]
}
{% endschema %}