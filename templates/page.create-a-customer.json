        "custom_liquid": "<style>\n  .create-account-section__message {\n    margin-bottom: 16px;\n    padding: 12px 14px;\n    border-radius: 4px;\n    font-size: 14px;\n    line-height: 1.4;\n  }\n\n  .create-account-section__message.is-success {\n    background: #e8f5e9;\n    color: #1b5e20;\n  }\n\n  .create-account-section__message.is-error {\n    background: #fdecea;\n    color: #b71c1c;\n  }\n\n  .create-account-section__button[disabled] {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n</style>\n<section class=\"create-account-section\">\n  <div class=\"create-account-section__inner\">\n    <h1 class=\"create-account-section__form-heading\">\n      Create an Account\n    </h1>\n\n    <div class=\"create-account-section__form-text rte\">\n      <p>Enter your email address and password to create your account.</p>\n    </div>\n\n    <form\n      id=\"CustomCustomerCreateForm\"\n      class=\"create-account-section__form\"\n      novalidate\n    >\n      <div\n        id=\"CustomCustomerCreateMessage\"\n        class=\"create-account-section__message\"\n        role=\"status\"\n        aria-live=\"polite\"\n        hidden\n      ></div>\n\n      <div class=\"create-account-section__field\">\n        <label\n          class=\"create-account-section__label\"\n          for=\"CustomCustomerCreateEmail\"\n        >\n          Email address\n        </label>\n\n        <input\n          type=\"email\"\n          id=\"CustomCustomerCreateEmail\"\n          class=\"create-account-section__input\"\n          spellcheck=\"false\"\n          autocapitalize=\"off\"\n          autocomplete=\"email\"\n          aria-required=\"true\"\n          required\n          placeholder=\"Email Address\"\n        >\n      </div>\n\n      <div class=\"create-account-section__field\">\n        <label\n          class=\"create-account-section__label\"\n          for=\"CustomCustomerCreatePassword\"\n        >\n          Password\n        </label>\n\n        <input\n          type=\"password\"\n          id=\"CustomCustomerCreatePassword\"\n          class=\"create-account-section__input\"\n          autocomplete=\"new-password\"\n          aria-required=\"true\"\n          required\n          minlength=\"8\"\n          placeholder=\"Password\"\n        >\n      </div>\n\n      <button\n        type=\"submit\"\n        id=\"CustomCustomerCreateSubmit\"\n        class=\"create-account-section__button\"\n      >\n        Create customer\n      </button>\n    </form>\n  </div>\n</section>\n\n<script>\n  (function () {\n    const form = document.getElementById('CustomCustomerCreateForm');\n    const emailInput = document.getElementById('CustomCustomerCreateEmail');\n    const passwordInput = document.getElementById('CustomCustomerCreatePassword');\n    const submitButton = document.getElementById('CustomCustomerCreateSubmit');\n    const messageBox = document.getElementById('CustomCustomerCreateMessage');\n\n    if (!form || !emailInput || !passwordInput || !submitButton || !messageBox) return;\n\n    const shopDomain = {{ shop.permanent_domain | json }};\n    const storefrontAccessToken = '3cd122dacc9153aa276bc0de05e03a25';\n    const apiVersion = '2025-10';\n\n    const endpoint = `https://${shopDomain}/api/${apiVersion}/graphql.json`;\n\n    const customerCreateMutation = `\n      mutation customerCreate($input: CustomerCreateInput!) {\n        customerCreate(input: $input) {\n          customer {\n            firstName\n            lastName\n            email\n            acceptsMarketing\n          }\n          customerUserErrors {\n            field\n            message\n            code\n          }\n        }\n      }\n    `;\n\n    function isValidEmail(email) {\n      return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n    }\n\n    function setLoading(isLoading) {\n      submitButton.disabled = isLoading;\n      submitButton.textContent = isLoading ? 'Creating customer...' : 'Create customer';\n    }\n\n    function showMessage(type, message) {\n      messageBox.hidden = false;\n      messageBox.textContent = message;\n      messageBox.classList.remove('is-success', 'is-error');\n      messageBox.classList.add(type === 'success' ? 'is-success' : 'is-error');\n    }\n\n    function getCustomerErrorMessage(errors) {\n      if (!errors || !errors.length) {\n        return 'Something went wrong. Please try again.';\n      }\n\n      return errors.map(function (error) {\n        return error.message;\n      }).join(' ');\n    }\n\n    async function createCustomer(email, password) {\n      const variables = {\n        input: {\n          email: email,\n          password: password,\n          acceptsMarketing: false\n        }\n      };\n\n      const response = await fetch(endpoint, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n        },\n        body: JSON.stringify({\n          query: customerCreateMutation,\n          variables: variables\n        })\n      });\n\n      return response.json();\n    }\n\n    form.addEventListener('submit', async function (event) {\n      event.preventDefault();\n\n      const email = emailInput.value.trim();\n      const password = passwordInput.value;\n\n      if (!email) {\n        showMessage('error', 'Please enter your email address.');\n        return;\n      }\n\n      if (!isValidEmail(email)) {\n        showMessage('error', 'Please enter a valid email address.');\n        return;\n      }\n\n      if (!password) {\n        showMessage('error', 'Please enter your password.');\n        return;\n      }\n\n      if (password.length < 8) {\n        showMessage('error', 'Password must be at least 8 characters.');\n        return;\n      }\n\n      setLoading(true);\n      messageBox.hidden = true;\n\n      try {\n        const result = await createCustomer(email, password);\n\n        console.log('[customerCreate result]', result);\n\n        const graphQLErrors = result?.errors || [];\n        const customerCreate = result?.data?.customerCreate;\n        const customer = customerCreate?.customer;\n        const customerUserErrors = customerCreate?.customerUserErrors || [];\n\n        if (graphQLErrors.length) {\n          showMessage('error', graphQLErrors[0].message || 'GraphQL request failed.');\n          return;\n        }\n\n        if (customerUserErrors.length) {\n          showMessage('error', getCustomerErrorMessage(customerUserErrors));\n          return;\n        }\n\n        if (customer) {\n          showMessage('success', 'Customer created successfully.');\n          form.reset();\n\n          /*\n            Optional redirect after account creation.\n\n            setTimeout(function () {\n              window.location.href = '/pages/home-profile';\n            }, 1200);\n          */\n        } else {\n          showMessage('error', 'Customer could not be created. Please try again.');\n        }\n      } catch (error) {\n        console.error('[customerCreate failed]', error);\n        showMessage('error', 'Request failed. Please try again.');\n      } finally {\n        setLoading(false);\n      }\n    });\n  })();\n</script>",
