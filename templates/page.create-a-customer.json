      "settings": {
        "custom_liquid": "<section class=\"create-account-section\">\n  <div class=\"create-account-section__inner\">\n    <h1 class=\"create-account-section__form-heading\">\n      Create an Account\n    </h1>\n\n    <div class=\"create-account-section__form-text rte\">\n      <p>Enter your email address to get started.</p>\n    </div>\n\n    {%- form 'customer', id: 'CustomCreateCustomerEmailForm', class: 'create-account-section__form' -%}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"pending_customer, profile_pending\">\n\n      <div\n        id=\"CustomCreateCustomerMessage\"\n        class=\"create-account-section__message\"\n        role=\"status\"\n        aria-live=\"polite\"\n        hidden\n      ></div>\n\n      <div class=\"create-account-section__field\">\n        <label\n          class=\"create-account-section__label\"\n          for=\"CustomCreateCustomerEmail\"\n        >\n          Email address\n        </label>\n\n        <input\n          type=\"email\"\n          name=\"contact[email]\"\n          id=\"CustomCreateCustomerEmail\"\n          class=\"create-account-section__input\"\n          spellcheck=\"false\"\n          autocapitalize=\"off\"\n          autocomplete=\"email\"\n          aria-required=\"true\"\n          required\n          placeholder=\"Email Address\"\n        >\n      </div>\n\n      <button\n        type=\"submit\"\n        id=\"CustomCreateCustomerSubmit\"\n        class=\"create-account-section__button\"\n      >\n        Create customer\n      </button>\n    {%- endform -%}\n  </div>\n</section>\n\n<script>\n  (function () {\n    const form = document.getElementById('CustomCreateCustomerEmailForm');\n    const submitButton = document.getElementById('CustomCreateCustomerSubmit');\n    const messageBox = document.getElementById('CustomCreateCustomerMessage');\n    const emailInput = document.getElementById('CustomCreateCustomerEmail');\n\n    if (!form || !submitButton || !messageBox || !emailInput) return;\n\n    function showMessage(type, message) {\n      messageBox.hidden = false;\n      messageBox.textContent = message;\n      messageBox.classList.remove('is-success', 'is-error');\n      messageBox.classList.add(type === 'success' ? 'is-success' : 'is-error');\n    }\n\n    function setLoading(isLoading) {\n      submitButton.disabled = isLoading;\n      submitButton.textContent = isLoading ? 'Creating customer...' : 'Create customer';\n    }\n\n    function isValidEmail(email) {\n      return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n    }\n\n    form.addEventListener('submit', async function (event) {\n      event.preventDefault();\n\n      const email = emailInput.value.trim();\n\n      if (!email) {\n        showMessage('error', 'Please enter your email address.');\n        return;\n      }\n\n      if (!isValidEmail(email)) {\n        showMessage('error', 'Please enter a valid email address.');\n        return;\n      }\n\n      setLoading(true);\n      messageBox.hidden = true;\n\n      try {\n        const formData = new FormData(form);\n\n        const response = await fetch(form.action, {\n          method: 'POST',\n          body: formData,\n          headers: {\n            'Accept': 'text/html'\n          }\n        });\n\n        if (!response.ok) {\n          throw new Error('Customer form request failed.');\n        }\n\n        showMessage('success', 'Thank you. Your customer profile has been started.');\n        form.reset();\n\n        /*\n          Optional redirect after successful email capture.\n          Uncomment and change the URL if needed.\n\n          setTimeout(function () {\n            window.location.href = '/pages/home-profile';\n          }, 1200);\n        */\n      } catch (error) {\n        console.error('[Custom customer email form]', error);\n        showMessage('error', 'Something went wrong. Please try again.');\n      } finally {\n        setLoading(false);\n      }\n    });\n  })();\n</script>",
